{
  "name": "orche-advisor",
  "version": "1.0.0",
  "description": "Checkpoint-only orchestration reviews for OMP and a standalone Bun CLI",
  "license": "UNLICENSED",
  "bin": {
    "orche-advisor": "./bin/orche-advisor.ts"
  },
  "files": [
    "orche-advisor.ts",
    "src/",
    "bin/",
    "examples/"
  ],
  "type": "module",
  "exports": {
    ".": "./orche-advisor.ts"
  },
  "scripts": {
    "start": "bun run bin/orche-advisor.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt orche-advisor.ts src bin tests package.json tsconfig.json"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "18.1.20",
    "@oh-my-pi/pi-coding-agent": "18.1.20"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.67.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./orche-advisor.ts"
    ]
  }
}
